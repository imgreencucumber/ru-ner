# Copy to .env and fill in. .env is gitignored.
DEEPSEEK_API_KEY=

# Authorization key from the GigaChat personal account (base64 of Client ID:Client Secret)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Optional: path to the Russian Trusted Root CA certificate. If empty, TLS verification is off.
GIGACHAT_CA_BUNDLE=

YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Hugging Face write token, used only by scripts/publish_hf.py
HF_TOKEN=
